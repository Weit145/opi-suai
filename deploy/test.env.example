# Copy to .env.test and replace the values before running deploy/run-tests.sh.
# The database name must end with _test: acceptance tests refuse other databases.
TEST_DB_PASSWORD=
DATABASE_URL=postgres://opi_test:CHANGE_ME@127.0.0.1:55434/opi_test?sslmode=disable
JWT_SECRET=
INTEGRATION_SECRET=
DEMO_PASSWORD=
DEMO_MODE=true
SECURE_COOKIES=false
PUBLIC_ORIGIN=http://localhost:5173
ADDR=127.0.0.1:8090
PROVIDER_URL=http://127.0.0.1:8091
APP_URL=http://127.0.0.1:8090
