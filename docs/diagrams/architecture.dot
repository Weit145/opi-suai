digraph architecture {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=14, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=14, color="#3f5f4f", fillcolor="#eef4ef", penwidth=1.3, margin="0.16,0.10"];
  edge [fontname="DejaVu Sans", fontsize=11, color="#4a5a52", arrowsize=0.8];

  browser [label="Браузер\nSPA React + TypeScript"];
  nginx [label="nginx\nTLS, CSP, reverse proxy"];
  api [label="Go API (chi)\nкаталог, заказы, платежи,\nсборка, склад, доставка"];
  provider [label="Go provider\nучебные платёжная\nи доставочная системы"];
  db [label="PostgreSQL 16\n16 таблиц, транзакции,\nрезервы, журналы"];
  backup [label="Резервное копирование\npg_dump -Fc\nраз в сутки"];

  browser -> nginx [label="HTTPS :8443"];
  nginx -> api [label="/api, /healthz, /readyz"];
  api -> db [label="SQL, транзакции"];
  api -> provider [label="HMAC-подпись\n/payments, /shipments"];
  provider -> api [label="callback\npayment webhook", style=dashed];
  backup -> db [label="дамп", style=dashed];

  {rank=same; api; provider;}
  {rank=same; db; backup;}
}
